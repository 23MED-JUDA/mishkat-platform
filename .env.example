# ================================================================
#  .env.example — نموذج متغيرات البيئة
#  منصة مشكاة التعليمية
# ================================================================
#  انسخ هذا الملف إلى .env واملأ القيم المناسبة لبيئتك
#  ملاحظة: لا ترفع ملف .env أبداً على Git
# ================================================================

# ─── البيئة الحالية ─────────────────────────────────────────────
# القيم المتاحة: local | staging | production
APP_ENV=local

# ─── إعدادات قاعدة البيانات ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mishkat_db
DB_USER=root
DB_PASS=

# ─── مثال بيئة Staging ──────────────────────────────────────────
# APP_ENV=staging
# DB_HOST=staging-db.mishkat.com
# DB_PORT=3306
# DB_NAME=mishkat_staging
# DB_USER=mishkat_stage
# DB_PASS=your_staging_password_here

# ─── مثال بيئة Production (Aiven / PlanetScale / Railway) ───────
# APP_ENV=production
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=22775
# DB_NAME=mishkat_db
# DB_USER=avnadmin
# DB_PASS=your_production_password_here
