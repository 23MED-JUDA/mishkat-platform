# Git ignore file for Mishkat Platform

# ─── متغيرات البيئة (لا ترفعها أبداً) ───────────────────────────
.env
.env.local
.env.staging
.env.production
# استثناء: ملف النموذج يرفع على Git
!.env.example

# ─── السجلات ─────────────────────────────────────────────────────
*.log
logs/

# ─── التبعيات ────────────────────────────────────────────────────
node_modules/

# ─── ملفات النظام ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── المرفوعات ───────────────────────────────────────────────────
/api/uploads/
/uploads/

# ─── النسخ الاحتياطية لقاعدة البيانات ───────────────────────────
*.sql
database/*.bak
database/*_backup*
